<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
    <xs:element name="hotelbookings">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="hotelbooking" minOccurs="1" maxOccurs="unbounded">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name:"bookingId" type="xs:positiveInteger"/>
                            <xs:element name="hotelName" type="xs:string"/>
                        </xs:sequence>
                    </xs:complexType>

                </xs:element>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
</xs:schema>